{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.aarwitz/tapp",
  "description": "Autonomous QA for iOS, Android, and web \u2014 agents get a scoped deterministic verdict with evidence",
  "repository": {
    "url": "https://github.com/aarwitz/tapp",
    "source": "github"
  },
  "version": "0.16.5",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@aarwitz/tapp",
      "version": "0.16.5",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "Start the Tapp MCP server on stdio"
        }
      ]
    }
  ]
}
